  68:Core/Src/init.c ****     // PA5 - зелёный диод на GPIOA
  69:Core/Src/init.c ****     SET_BIT(GPIOA->MODER, GPIO_MODER_MODER5_0);
  70:Core/Src/init.c ****     CLEAR_BIT(GPIOA->MODER, GPIO_MODER_MODER5_1);
  71:Core/Src/init.c ****     // PC5 - зелёный диод на GPIOC
  72:Core/Src/init.c ****     SET_BIT(GPIOC->MODER, GPIO_MODER_MODER5_0);
  73:Core/Src/init.c ****     CLEAR_BIT(GPIOC->MODER, GPIO_MODER_MODER5_1);
  74:Core/Src/init.c **** 
  75:Core/Src/init.c ****     // Красные светодиоды (прямое обращение)
  76:Core/Src/init.c ****     GPIOA_MODER |= MODER_PA6_OUTPUT;        // PA6 - красный диод на GPIOA
  77:Core/Src/init.c ****     GPIOB_MODER |= MODER_PB1_OUTPUT;        // PB1 - красный диод на GPIOB
  78:Core/Src/init.c ****     // Синие светодиоды (прямое обращение)
  79:Core/Src/init.c ****     GPIOC_MODER |= MODER_PC6_OUTPUT;        // PC6 - синий диод на GPIOC
  80:Core/Src/init.c ****     GPIOB_MODER |= MODER_PB2_OUTPUT;        // PB2 - синий диод на GPIOB
